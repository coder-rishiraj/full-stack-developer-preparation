# Firebase web config (free Spark plan) — enables sign-in and cloud progress sync.
# The real values for the career-duo project are committed in .env. Copy this to .env.local only to
# point one machine at a different Firebase project.
# These values are public identifiers, not secrets: firestore.rules is what protects each user's data.
# Leave them empty to run in guest-only mode (progress saved in the browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
